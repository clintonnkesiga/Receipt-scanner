# Copy to .env and fill in your values.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/receipts

# SeaweedFS filer base URL (no trailing slash).
# In Docker Compose this is overridden to http://seaweed-filer:8888 automatically.
# For local dev outside Docker, start SeaweedFS manually and set this accordingly.
SEAWEEDFS_FILER_URL=http://localhost:8888

# CORS: the frontend dev server origin
FRONTEND_ORIGIN=http://localhost:5173

# Optional: path to the tesseract binary if it's not on PATH
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# --- Auth ---
# Generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Super-admin created by `python -m app.seed`
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_this_strong_password
SUPERADMIN_NAME=Super Admin
